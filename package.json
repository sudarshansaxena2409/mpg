{
  "name": "mpa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "mpa": "./dist/cli/src/index.js"
  },
  "scripts": {
    "build": "cd web && npm install && npm run build",
    "build:cli": "tsc -p tsconfig.json",
    "dev": "tsx cli/src/index.ts",
    "dev:web": "cd web && npm run dev",
    "install:web": "cd web && npm install",
    "check": "tsc -p tsconfig.json --noEmit",
    "generate:bindings": "spacetime generate mpa --lang typescript -p spacetimedb -o cli/src/module_bindings -y && npm run postprocess:bindings",
    "publish:local": "spacetime publish -s local -p spacetimedb -y mpa",
    "postprocess:bindings": "node scripts/postprocess-bindings.cjs",
    "pack:cli": "npm run build && mkdir -p release && npm pack --pack-destination release"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "ink": "^6.5.1",
    "react": "^19.2.1",
    "spacetimedb": "^2.8.1",
    "undici": "^6.19.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
